<Window x:Class="ChestCounter.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chest Counter" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False" Topmost="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#F2F3F7" UseLayoutRounding="True">

    <!-- Margin leaves room for the shadow -->
    <Border x:Name="Card" Margin="28" Width="430" CornerRadius="16" Padding="24,22,24,20" BorderThickness="1"
            Background="#181B24" BorderBrush="#343949" RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.65" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Grid Width="40" Height="40">
                    <Ellipse Width="58" Height="58" Margin="-9" Opacity="0.35">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#B0FFD54F" Offset="0"/>
                                <GradientStop Color="#00FFD54F" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image Source="{StaticResource ChestImage}" Width="38" Height="38"/>
                </Grid>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Margin="14,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="MessageText" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="13.5" LineHeight="20"
                       Foreground="#B4B8C6"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Btn}" MinWidth="96"
                        Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource PrimaryBtn}" MinWidth="96"
                        IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
