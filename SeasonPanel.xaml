<UserControl x:Class="ChestCounter.SeasonPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <!-- Account -->
        <TextBlock Text="Your Fortnite account" Style="{StaticResource Section}" Margin="4,0,0,8"/>
        <Border Style="{StaticResource Card}" Padding="16,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Epic name" Style="{StaticResource RowSub}" VerticalAlignment="Center"/>
                    <TextBox x:Name="NameBox" Grid.Column="1" Height="34" MaxLength="40" Style="{StaticResource Field}"
                             LostFocus="Field_Commit"/>
                    <Button x:Name="PlatformButton" Grid.Column="2" Style="{StaticResource Btn}" Height="34" MinWidth="120"
                            Margin="8,0,0,0" Click="Platform_Click" ToolTip="Which account the name belongs to (click to change)"/>

                    <TextBlock Grid.Row="1" Text="API key" Style="{StaticResource RowSub}" VerticalAlignment="Center"/>
                    <TextBox x:Name="KeyBox" Grid.Row="1" Grid.Column="1" Height="34" MaxLength="64" Style="{StaticResource Field}"
                             FontFamily="Consolas" LostFocus="Field_Commit"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Get a free key" Style="{StaticResource Btn}" Height="34"
                            MinWidth="120" Margin="8,0,0,0" Click="GetKey_Click"/>
                </Grid>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource RowSub}"
                           Text="Free key from Fortnite-API.com (same Epic stats as Fortnite Tracker). Your friend sets up his own."/>
                <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,0"/>
                <Grid Margin="0,10,0,0">
                    <StackPanel Margin="0,0,60,0">
                        <TextBlock Text="Automatic End game" Style="{StaticResource RowTitle}"/>
                        <TextBlock x:Name="AutoText" Style="{StaticResource RowSub}" TextWrapping="Wrap"
                                   Text="Saves each game for you when Fortnite records the match. Chests you open in the next game stay in the next game, even though the stats arrive a few minutes late."/>
                    </StackPanel>
                    <CheckBox x:Name="AutoToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Click="AutoToggle_Click"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource RowSub}" VerticalAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,140,0"/>
                    <Button x:Name="RefreshButton" Content="Refresh stats" Style="{StaticResource PrimaryBtn}"
                            HorizontalAlignment="Right" Click="Refresh_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Season numbers -->
        <TextBlock Text="This season" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
                <UniformGrid Columns="4">
                    <StackPanel>
                        <TextBlock x:Name="MatchesStat" Text="–" FontFamily="Bahnschrift, Segoe UI" FontWeight="Bold" FontSize="26"/>
                        <TextBlock Text="Matches" Style="{StaticResource RowSub}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="WinsStat" Text="–" FontFamily="Bahnschrift, Segoe UI" FontWeight="Bold" FontSize="26"/>
                        <TextBlock Text="Wins" Style="{StaticResource RowSub}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="AvgStat" Text="–" FontFamily="Bahnschrift, Segoe UI" FontWeight="Bold" FontSize="26"/>
                        <TextBlock Text="Your avg chests / game" Style="{StaticResource RowSub}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="ChestsStat" Text="–" FontFamily="Bahnschrift, Segoe UI" FontWeight="Bold" FontSize="26"
                                   Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="Est. chests this season" Style="{StaticResource RowSub}"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="FriendLine" Margin="0,12,0,0" Style="{StaticResource RowSub}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Odds -->
        <Grid Margin="4,14,0,8">
            <TextBlock x:Name="LootTitle" Text="Loot odds" Style="{StaticResource Section}" Margin="0"
                       VerticalAlignment="Bottom"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="WeekText" Style="{StaticResource RowSub}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="New week" Style="{StaticResource Btn}" Padding="12,5" Click="NewWeek_Click"
                        ToolTip="Restart the weekly items from 0 chests. Pirate Shop Access keeps the whole season."/>
            </StackPanel>
        </Grid>
        <Border Style="{StaticResource Card}" Padding="16,10">
            <StackPanel>
                <Grid Margin="0,4,0,6" TextElement.Foreground="{StaticResource Sub}" TextElement.FontSize="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Item"/>
                    <TextBlock Grid.Column="1" Text="Odds per chest"/>
                    <TextBlock Grid.Column="2" Text="You" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="FriendHeader" Grid.Column="3" Text="Friend" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="EitherHeader" Grid.Column="4" Text="Either of you" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="5" Text="Got it" HorizontalAlignment="Right"/>
                </Grid>
                <Border Height="1" Background="{StaticResource Line}"/>

                <ItemsControl x:Name="OddsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" Foreground="{Binding NameBrush}"/>
                                    <TextBlock Text="{Binding Expected}" Style="{StaticResource RowSub}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Odds}" VerticalAlignment="Center"
                                           FontFamily="Bahnschrift, Segoe UI" Foreground="{StaticResource Sub}"/>
                                <TextBlock Grid.Column="2" Text="{Binding You}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontFamily="Bahnschrift, Segoe UI" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Grid.Column="3" Text="{Binding Friend}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontFamily="Bahnschrift, Segoe UI" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Grid.Column="4" Text="{Binding Either}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontFamily="Bahnschrift, Segoe UI" FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource Accent}"/>
                                <CheckBox Grid.Column="5" Style="{StaticResource Toggle}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" IsChecked="{Binding Got, Mode=OneWay}" Tag="{Binding Key}"
                                          Click="Got_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,8,0,4" TextWrapping="Wrap" Style="{StaticResource RowSub}"
                           Text="Chance of getting each item at least once. Weekly items use the chests you've counted since New week; season items use season matches × your average chests per game."/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
